# Fulloch Environment Variables
# Copy to .env and fill in your values; loaded automatically via python-dotenv.
# The whole file is OPTIONAL — `docker compose up` works without it (sensible
# defaults apply). Create it to set the values below.

# =============================================================================
# Web Search (SearXNG)
# =============================================================================
# Overrides server.secret_key in searxng_data/settings.yml at runtime.
# Optional — compose falls back to a placeholder for local use. Set a real value
# before exposing SearXNG beyond localhost. Generate with: openssl rand -hex 32
SEARXNG_SECRET=

# =============================================================================
# Dashboard auth (optional)
# =============================================================================
# When set, every dashboard request must carry this token (Authorization: Bearer
# header, or ?token=... for the live stream). Blank = no auth, only safe when
# dashboard_host is 127.0.0.1. REQUIRED when binding to 0.0.0.0. Generate with:
# openssl rand -hex 32. (HTTPS is separate — dashboard_ssl_* in config.yml.)
FULLOCH_DASHBOARD_TOKEN=

# =============================================================================
# Remote LLM / Parloch mode (optional — only for models.llm.backend: openai)
# =============================================================================
# When the language model runs off-device on an OpenAI-compatible endpoint, the
# endpoint (models.llm.base_url) and model (models.llm.model) live in config.yml;
# only the API key belongs here, to keep the secret out of committed config.
# OPENAI_API_KEY is used as a fallback; if neither is set the client sends
# "not-needed" (fine for local servers that ignore it).
FULLOCH_LLM_API_KEY=
# OPENAI_API_KEY=

# =============================================================================
# Container healthcheck port (optional)
# =============================================================================
# Port the compose healthcheck curls for /status; must match
# general.dashboard_port in config.yml (default 8765). On a mismatch (or when the
# dashboard is disabled / HTTPS), it falls back to a process check. Only matters
# under an orchestrator / autoheal sidecar — `restart: unless-stopped` ignores it.
DASHBOARD_PORT=8765

# =============================================================================
# Audio device routing (optional — Linux/Docker only)
# =============================================================================
# Pulse/PipeWire device names the container routes its "default" audio through.
# Unset = the host's system-default source/sink. Set these to a device's pactl
# names (`pactl list short sinks` / `... sources`) to pin it. PipeWire
# resamples, so any native rate works (unlike config.yml's input_device/
# output_device, which is the native/Windows path). An unplugged device falls
# back to the system default.
# PULSE_SOURCE=alsa_input.usb-..._Adapter_A300-01.mono-fallback
# PULSE_SINK=alsa_output.usb-..._Adapter_A300-01.analog-stereo

# =============================================================================
# Home Assistant token (optional — overrides home_assistant.token in config.yml)
# =============================================================================
# Long-lived token, preferred over plaintext in config.yml.
# Create one at http://<your-ha>:8123/profile.
FULLOCH_HA_TOKEN=
