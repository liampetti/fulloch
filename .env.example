# Fulloch Environment Variables
# Copy this file to .env and update with your values.
# These values are loaded automatically via python-dotenv.

# =============================================================================
# Web Search (SearXNG)
# =============================================================================
# Overrides server.secret_key in searxng_data/settings.yml at runtime.
# Required by compose.yml. Generate one with: openssl rand -hex 32
SEARXNG_SECRET=

# =============================================================================
# Dashboard auth (optional)
# =============================================================================
# When set, the web dashboard requires this token on every request (sent as an
# Authorization: Bearer header, or ?token=... for the live stream). Leave blank
# for no auth — only safe when dashboard_host is 127.0.0.1 (local-only).
# REQUIRED if you bind the dashboard to 0.0.0.0 for access from other devices.
# Generate one with: openssl rand -hex 32
# (HTTPS is configured separately, via dashboard_ssl_certfile / dashboard_ssl_keyfile
#  in data/config.yml — see "Exposing the dashboard" in the README.)
FULLOCH_DASHBOARD_TOKEN=

# =============================================================================
# Container healthcheck port (optional)
# =============================================================================
# Port the compose healthcheck curls for /status. Must match
# general.dashboard_port in data/config.yml. Defaults to 8765 if unset. If it
# doesn't match (or the dashboard is disabled / HTTPS), the healthcheck falls
# back to a process check. Only meaningful under an orchestrator / autoheal
# sidecar — plain `restart: unless-stopped` ignores health status.
DASHBOARD_PORT=8765

# =============================================================================
# Home Assistant token (optional — overrides home_assistant.token in config.yml)
# =============================================================================
# Long-lived access token for Home Assistant. Prefer setting it here rather than
# in plaintext config.yml. Create one at http://<your-ha>:8123/profile.
FULLOCH_HA_TOKEN=
